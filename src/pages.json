{
  // +----------------------------------------------------------------------
  // | @project   BenXinAdmin
  // | @mission   页面路由与全局配置
  // | @author    仗键天涯(daxing)
  // | @email     3442535897@qq.com
  // | @date      2026-06-08
  // | @updated   2026-06-16（C 端演示升级：新增文章 tab、首页自定义导航、tabBar 三 tab + 品牌图标）
  // +----------------------------------------------------------------------

  // wot-design-uni 组件自动按需引入（easycom）
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      // 首页自定义导航：hero 渐变全幅延伸至状态栏下（页面内自行让出安全区 + 胶囊区）
      "path": "pages/index/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "BenXinAdmin",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/article/article",
      "style": {
        "navigationBarTitleText": "文章",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/content/detail",
      "style": {
        "navigationBarTitleText": "详情"
      }
    },
    {
      "path": "pages/mine/mine",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/login/login",
      "style": {
        "navigationBarTitleText": "登录"
      }
    }
  ],
  // 原生 tabBar（跨端一致、真 tab 切换）；图标为自绘品牌线性 PNG（§10 合规，自有素材）
  "tabBar": {
    "color": "#9aa1ad",
    "selectedColor": "#2b6fff",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/article/article",
        "text": "文章",
        "iconPath": "static/tabbar/article.png",
        "selectedIconPath": "static/tabbar/article-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "static/tabbar/mine.png",
        "selectedIconPath": "static/tabbar/mine-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "BenXinAdmin",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#f4f6fa"
  }
}
